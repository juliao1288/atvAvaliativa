programa { 
  
  inclua biblioteca Matematica -->Mat
  inclua biblioteca Util --> u
  funcao inicio() { 

    real n1,n2	
    cadeia conta

    escreva("Escreva o primeiro numero: ")
    leia(n1) 
    escreva("digite o segundo numero: ")
    leia(n2)
    escreva("escolha entre soma e subtracao: ")
    leia(conta)

    
